<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sortfold" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Sortfold.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sortfold_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Sortfold</item>
    </style>
</resources>
