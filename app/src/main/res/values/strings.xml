    <!-- Permission rationale -->
    <string name="rationale_media_title">Allow access to photos and videos?</string>
    <string name="rationale_media_body">Sortfold uses this to read dates and dimensions of your media, so date and resolution sorting is accurate. The folder itself is accessed through the system folder picker, which needs no permission.</string>
    <string name="rationale_media_will_not">Sortfold will not upload, modify or delete anything without showing it to you first.</string>
    <string name="rationale_without">Continue without</string>
    <string name="rationale_continue">Continue</string>
    <string name="rationale_not_now">Not now</string>
    <string name="rationale_notifications_title">Show progress notifications?</string>
    <string name="rationale_notifications_body">Sorting runs in the background. A notification shows real progress and gives you Pause and Cancel buttons.</string>
    <string name="rationale_notifications_will_not">Sortfold will not send marketing or any other notifications.</string>
    <string name="perm_degraded_title">Working with limited access</string>
    <string name="perm_degraded_body">Without media access, dates and resolutions may be unavailable, so those sort modes fall back to file dates and default buckets. Everything else works normally.</string>

