    <!-- Onboarding -->
    <string name="onboard_loader_label">Sortfold logo animation</string>
    <string name="onboard1_title">See the plan first</string>
    <string name="onboard1_body">Sortfold scans a folder you choose and shows every planned move before anything happens.</string>
    <string name="onboard2_title">You stay in control</string>
    <string name="onboard2_body">Pause, cancel or undo at any time. Nothing is deleted — moves are logged and reversible.</string>
    <string name="onboard3_title">Private by design</string>
    <string name="onboard3_body">No ads, no analytics, no account. The network is only used to check for updates.</string>
    <string name="onboard_start">Get started</string>

